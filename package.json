{
  "name": "claude-code-engine",
  "version": "1.0.0",
  "description": "Enterprise-grade AI coding assistant engine",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "bun run src/main.ts",
    "main": "bun run src/main.ts",
    "cli": "bun run src/cli.ts",
    "sdk": "bun run src/sdk.ts",
    "demo": "bun run src/sdk.ts",
    "test": "bun test",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t claude-code-engine .",
    "docker:run": "docker run --rm -it claude-code-engine"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "license": "MIT"
}
